  "usage": {
    "quickstart": [
      "import * as THREE from 'three'",
      "import { GLTFLoader } from 'three/examples/jsm/loaders/GLTFLoader.js'",
      "import { CharacterController } from './SorceressCharacterRuntime.js'",
      "import { setupCharacterPhysics } from './CharacterPhysics.js'",
      "const CHAR_DIR = './characters/office-employee2/'",
      "const gltf = await new GLTFLoader().loadAsync(CHAR_DIR + 'office-employee2.glb')",
      "// Load every clip in the character folder (see manifest.files.animations):",
      "const manifest = await fetch(CHAR_DIR + 'manifest.json').then(r => r.json())",
      "const clips = {}",
      "for (const a of manifest.files.animations) clips[a.name] = THREE.AnimationClip.parse(await fetch(CHAR_DIR + a.file).then(r => r.json()))",
      "const all = Object.values(clips)",
      "const pick = (kw) => all.find(c => c.name.toLowerCase().includes(kw))",
      "const physics = await fetch(CHAR_DIR + 'physics-config.json').then(r => r.json())",
      "const controller = new CharacterController({ root: gltf.scene, clips: { idle: pick('idle') ?? all[0], walk: pick('walk') ?? all[0], run: pick('run') ?? all[0] }, physics })",
      "// hair + cloth secondary motion (optional — self-hooks into rendering):",
      "const charPhysics = setupCharacterPhysics(gltf.scene, { hair: physics.hair, cloth: physics.cloth })",
      "// per frame: controller.update(deltaSeconds, { forward, back, left, right, sprint, jump, cameraForward })"
    ],
    "notes": "RUNTIME NOT INCLUDED: this is a CHARACTER + ANIMATIONS bundle for a project that already has the Sorceress runtime files (SorceressCharacterRuntime.js, CharacterPhysics.js, humanoidCharacter.js, …) and AGENT_INSTRUCTIONS.md from a previously downloaded full Three.js Package. Drop this bundle's characters/office-employee2/ folder into the project's existing characters/ folder (next to the other characters) and wire it exactly the same way — the quickstart below and the original AGENT_INSTRUCTIONS.md apply unchanged. This is a COMBINED export: one office-employee2.glb with the body + all accessories on a single skeleton. Assign the clip to any locomotion slots (idle/walk/run/jump) or generate more clips and parse them the same way."
  }
